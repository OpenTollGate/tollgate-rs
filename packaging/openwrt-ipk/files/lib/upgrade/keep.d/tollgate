# Kept across a sysupgrade. The identity is the node: lose it and every
# voucher a peer holds becomes a claim on an issuer that no longer exists.
/etc/tollgate/tollgate.yaml
# And the wallet is the money. These are bearer tokens; there is no recovering
# them from anywhere else.
/etc/tollgate/wallet.sqlite
# And the mint's spent-proof set. The keys are derived from the identity, so
# they come back without it; the memory of what was already redeemed does not.
/etc/tollgate/mint.sqlite
# With its write-ahead log: sysupgrade takes its copy while the node is still
# running, and the most recent redemptions are in the log until a checkpoint.
/etc/tollgate/mint.sqlite-wal
