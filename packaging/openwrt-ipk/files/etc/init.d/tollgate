#!/bin/sh /etc/rc.common
# TollGate node — procd init script for OpenWrt

USE_PROCD=1
# After the network and the firewall: the enforcer installs its own nftables
# table and tc classes on the forwarding path, and fw4 flushing afterwards
# would take them with it.
START=96
STOP=10

PROG=/usr/bin/tollgated
CONFIG=/etc/tollgate/tollgate.yaml
MINT=/usr/bin/mintd
MINT_CONFIG=/etc/tollgate/mint.yaml
MINT_SOCKET=/run/mintd.sock
MERCHANT=/usr/bin/merchantd
MERCHANT_CONFIG=/etc/tollgate/merchant.yaml

start_service() {
	# The shaper needs the queueing disciplines, and gating needs conntrack.
	# Both are package dependencies; loading them here covers a router where
	# something unloaded them.
	modprobe sch_htb 2>/dev/null || true
	modprobe nf_conntrack 2>/dev/null || true

	# The mint, its own daemon: tollgated holds none of its keys and settles at
	# it over HTTP, retrying if it is not up yet.
	procd_open_instance mint
	procd_set_param command "$MINT" --config "$MINT_CONFIG" --control-socket "$MINT_SOCKET"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The merchant: prices and sells, holds the money, and supplies the
	# vouchers tollgated funds its channels with.
	procd_open_instance merchant
	procd_set_param command "$MERCHANT" --config "$MERCHANT_CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance node
	procd_set_param command "$PROG" --config "$CONFIG" --instance default
	# Its control socket is /run/tollgate-default/control.sock, in a runtime
	# directory tollgated makes for itself; tolltop finds it there.
	# Respawn: restart after 5 s, give up after 5 consecutive failures within
	# an hour, then reset the counter and try again. A node that cannot start
	# is usually a node whose config names an interface that is not there.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# The enforcer tears its own table down on a clean exit; this is for the
	# case where it did not get one.
	nft delete table inet tollgate 2>/dev/null || true
}

reload_service() {
	restart
}
