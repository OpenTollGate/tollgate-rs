; TollGate gate protocol, version 1 -- CDDL schema (RFC 8610)
;
; NORMATIVE. This file is the definition of what passes between `tollgated`
; and a gate -- an enforcement program it does not contain -- on the gate
; socket (docs/design/core/tollgate-gate-protocol.md). `src/gate.rs`
; implements it and `tests/gate_schema.rs` checks every message the codec
; emits against it. When the code and this schema disagree, the code is
; wrong -- or both change, in the same PR.
;
; ---------------------------------------------------------------------------
; Transport and framing (not CBOR, so not expressible below)
; ---------------------------------------------------------------------------
;
; A Unix socket. The gate listens; `tollgated` connects, and reconnects
; whenever the connection drops. Each message is preceded by its length as a
; 2-byte little-endian unsigned integer, exactly as on the TollGate wire
; (tollgate.cddl), so a message is at most 65535 bytes.
;
; The first message on every connection is the gate's `hello`. `tollgated`
; sends nothing before it, then the full state: a `bind` and a `set` for
; every payer it tracks. After that everything is incremental.
;
; A message that does not validate, a message type the receiver does not
; expect, a `bind` naming a kind the gate did not list, or a delegated
; binding sent to a gate that refuses them is a protocol error: the receiver
; closes the connection.
;
; ---------------------------------------------------------------------------
; Encoding rules CDDL cannot state
; ---------------------------------------------------------------------------
;
; The wire protocol's, unchanged: every message is a DEFINITE-length map;
; key 0 carries the message type and may appear anywhere in the map; map
; keys are unsigned integers 0..255; unknown keys are skipped, which the
; catch-all `* uint => any` says; a known key whose value has the wrong type
; makes the message invalid; integers accept any encoding whose value fits,
; and senders use the shortest form.
;
; Type tags are 0x20..0x25, disjoint from the wire protocol's, so a frame
; sent to the wrong socket fails to decode rather than meaning something
; else.

gate-message = hello
             / bind
             / set
             / remove
             / counters
             / conflict

; ---------------------------------------------------------------------------
; Scalars
; ---------------------------------------------------------------------------

u8  = uint .size 1
u32 = uint .size 4
u64 = uint .size 8

; The payer: the TollGate key a session runs under, compressed. `peer` in
; every message is always the payer, never a subject.
payer = bstr .size 33

subject-kind = &(
  kind-ipv4:   0,
  kind-ipv6:   1,
  kind-mac:    2,
  kind-pubkey: 3,
  kind-opaque: 4,
)

; What a gate's data plane matches. A FIPS address is not a kind: the gate
; derives it from a `pubkey`, and an `ipv6` in fd00::/8 is just an address.
subject = [0, bstr .size 4]                  ; ipv4
        / [1, bstr .size 16]                 ; ipv6
        / [2, bstr .size 6]                  ; mac
        / [3, bstr .size 32]                 ; pubkey, x-only
        / [4, u32, bstr .size (0..64)]       ; opaque: kind, value

; A subject a payer holds, and whether a local trusted client delegated it.
binding = [subject, delegated: bool]

identify = &(
  identify-claimed: 0,
  identify-fips:    1,
)

; ---------------------------------------------------------------------------
; Messages
; ---------------------------------------------------------------------------

; 0x20 -- gate -> tollgated. First message on every connection.
hello = {
  0: 0x20,
  1: u8,                          ; version; 1
  2: [+ subject-kind],            ; kinds matched
  3: identify,                    ; the mode tollgated must run
  4: bool,                        ; accepts delegated bindings
  ? 5: [* u32],                   ; opaque kinds matched; absent means none.
                                  ;   Senders write it only when non-empty
  * uint => any,
}

; 0x21 -- tollgated -> gate. Every subject the payer holds; replaces any
; earlier set.
bind = {
  0: 0x21,
  1: payer,
  2: [0*8 binding],               ; empty unbinds everything
  * uint => any,
}

; 0x22 -- tollgated -> gate. The payer's whole state.
set = {
  0: 0x22,
  1: payer,
  2: u64 / null,                  ; 0 closed, n bytes/s shaped, null unshaped
  * uint => any,
}

; 0x23 -- tollgated -> gate. The payer and its subjects are forgotten.
remove = {
  0: 0x23,
  1: payer,
  * uint => any,
}

; 0x24 -- gate -> tollgated. Cumulative from the payer's first bind on this
; connection, summed over all its subjects.
counters = {
  0: 0x24,
  1: payer,
  2: u64,                         ; delivered: to the payer's subjects
  3: u64,                         ; received: from them
  * uint => any,
}

; 0x25 -- gate -> tollgated. A binding refused because another payer holds
; the subject. PLACEHOLDER semantics, see the design doc's Conflicts.
conflict = {
  0: 0x25,
  1: payer,                       ; the payer refused
  2: subject,
  * uint => any,
}
