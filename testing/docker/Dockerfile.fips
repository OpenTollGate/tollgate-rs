# syntax=docker/dockerfile:1
# One image carrying both daemons: fipsd forwards, tollgated sells.
#
# Neither binary is compiled here — both are lifted from images that already
# built them, so a topology change costs a layer copy rather than two Rust
# builds. Build context is this directory (see scripts/build-fips.sh), which is
# why nothing outside it is referenced.

FROM tollgate-test:latest AS tollgate

FROM fips-node:latest

COPY --from=tollgate /usr/local/bin/tollgated /usr/local/bin/tollgated
COPY --from=tollgate /usr/local/bin/tolltop /usr/local/bin/tolltop
COPY --from=tollgate /usr/local/bin/mintd /usr/local/bin/mintd
COPY --from=tollgate /usr/local/bin/minttop /usr/local/bin/minttop
COPY --from=tollgate /usr/local/bin/merchantd /usr/local/bin/merchantd
COPY --from=tollgate /usr/local/bin/merchanttop /usr/local/bin/merchanttop
COPY --from=tollgate /usr/local/bin/tollgate-node /usr/local/bin/tollgate-node

COPY fips-entrypoint.sh /usr/local/bin/fips-entrypoint.sh
RUN chmod +x /usr/local/bin/fips-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/fips-entrypoint.sh"]
